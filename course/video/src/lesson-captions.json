[
  {
    "start": 0.895,
    "end": 3.655,
    "text": "欢迎来到方块世界的拳击擂台！"
  },
  {
    "start": 3.675,
    "end": 4.757,
    "text": "同样出一拳，"
  },
  {
    "start": 4.777,
    "end": 5.632,
    "text": "有时打中，"
  },
  {
    "start": 5.652,
    "end": 7.132,
    "text": "有时却打空。"
  },
  {
    "start": 7.152,
    "end": 9.039,
    "text": "计算机究竟怎么判断呢？"
  },
  {
    "start": 18.895,
    "end": 20.689,
    "text": "先看一小段游戏。"
  },
  {
    "start": 20.709,
    "end": 22.303,
    "text": "机器人移动、出拳，"
  },
  {
    "start": 22.323,
    "end": 24.507,
    "text": "打中时对手少一格生命。"
  },
  {
    "start": 24.527,
    "end": 27.345,
    "text": "今天我们要破解这一拳背后的数学秘密。"
  },
  {
    "start": 35.095,
    "end": 37.064,
    "text": "每个格子都有一个门牌号，"
  },
  {
    "start": 37.084,
    "end": 38.185,
    "text": "叫坐标。"
  },
  {
    "start": 38.205,
    "end": 40.082,
    "text": "左下角是零、零。"
  },
  {
    "start": 40.102,
    "end": 42.65,
    "text": "横坐标表示从左往右第几列，"
  },
  {
    "start": 42.67,
    "end": 45.034,
    "text": "纵坐标表示从下往上第几排。"
  },
  {
    "start": 46.029,
    "end": 48.236,
    "text": "蓝色身体占两列、两排，"
  },
  {
    "start": 48.256,
    "end": 49.675,
    "text": "总共四格。"
  },
  {
    "start": 49.695,
    "end": 51.106,
    "text": "横坐标是五和六，"
  },
  {
    "start": 51.126,
    "end": 52.868,
    "text": "纵坐标是三和四。"
  },
  {
    "start": 52.888,
    "end": 53.868,
    "text": "判断命中，"
  },
  {
    "start": 53.888,
    "end": 56.49,
    "text": "就要知道拳臂会不会碰到这四格。"
  },
  {
    "start": 57.462,
    "end": 59.022,
    "text": "拳头从六、五出发，"
  },
  {
    "start": 59.042,
    "end": 61.301,
    "text": "拳臂再向下伸出三格。"
  },
  {
    "start": 61.321,
    "end": 62.392,
    "text": "连同起点，"
  },
  {
    "start": 62.412,
    "end": 64.006,
    "text": "一共占四格。"
  },
  {
    "start": 64.026,
    "end": 66.628,
    "text": "我们让橙色拳臂一格一格地走下去。"
  },
  {
    "start": 67.629,
    "end": 68.154,
    "text": "看，"
  },
  {
    "start": 68.174,
    "end": 71.002,
    "text": "拳臂经过六、四和六、三。"
  },
  {
    "start": 71.022,
    "end": 73.706,
    "text": "这两个格子也属于蓝色身体。"
  },
  {
    "start": 73.726,
    "end": 75.241,
    "text": "橙色和蓝色重叠，"
  },
  {
    "start": 75.261,
    "end": 76.252,
    "text": "变成绿色，"
  },
  {
    "start": 76.272,
    "end": 77.42,
    "text": "这一拳打中了。"
  },
  {
    "start": 78.395,
    "end": 80.575,
    "text": "把拳头移到八、六。"
  },
  {
    "start": 80.595,
    "end": 81.95,
    "text": "纵向虽然够得到，"
  },
  {
    "start": 81.97,
    "end": 84.78,
    "text": "横坐标八却不在身体的两列里。"
  },
  {
    "start": 84.8,
    "end": 86.348,
    "text": "拳臂从旁边经过，"
  },
  {
    "start": 86.368,
    "end": 87.084,
    "text": "所以打空。"
  },
  {
    "start": 88.095,
    "end": 89.798,
    "text": "再看六、八。"
  },
  {
    "start": 89.818,
    "end": 91.15,
    "text": "横向已经对准，"
  },
  {
    "start": 91.17,
    "end": 93.56,
    "text": "但拳臂最远只到纵坐标五，"
  },
  {
    "start": 93.58,
    "end": 95.548,
    "text": "碰不到身体的最高一排四，"
  },
  {
    "start": 95.568,
    "end": 96.42,
    "text": "所以也打空。"
  },
  {
    "start": 97.395,
    "end": 100.875,
    "text": "在这个身体固定、拳臂向下伸三格的场景里，"
  },
  {
    "start": 100.895,
    "end": 102.625,
    "text": "起点位于身体上方时，"
  },
  {
    "start": 102.645,
    "end": 103.978,
    "text": "横坐标是五或六，"
  },
  {
    "start": 103.998,
    "end": 106.382,
    "text": "纵坐标可以是五、六或七。"
  },
  {
    "start": 106.402,
    "end": 107.496,
    "text": "比如六、七，"
  },
  {
    "start": 107.516,
    "end": 109.996,
    "text": "拳臂末端仍会碰到身体。"
  },
  {
    "start": 110.016,
    "end": 111.584,
    "text": "两个条件要同时成立。"
  },
  {
    "start": 112.595,
    "end": 114.173,
    "text": "现在轮到你。"
  },
  {
    "start": 114.193,
    "end": 115.753,
    "text": "每题先自己想一想，"
  },
  {
    "start": 115.773,
    "end": 117.364,
    "text": "答案会在倒数后出现。"
  },
  {
    "start": 122.412,
    "end": 123.574,
    "text": "横坐标对准，"
  },
  {
    "start": 123.594,
    "end": 125.035,
    "text": "纵坐标够到。"
  },
  {
    "start": 125.055,
    "end": 126.683,
    "text": "拳臂与身体重叠，"
  },
  {
    "start": 126.703,
    "end": 127.146,
    "text": "打中！"
  },
  {
    "start": 132.145,
    "end": 133.807,
    "text": "横坐标八偏到右边，"
  },
  {
    "start": 133.827,
    "end": 134.728,
    "text": "虽然够得到，"
  },
  {
    "start": 134.748,
    "end": 135.611,
    "text": "仍然打空。"
  },
  {
    "start": 140.645,
    "end": 141.91,
    "text": "横向对准了，"
  },
  {
    "start": 141.93,
    "end": 143.148,
    "text": "但纵向太远，"
  },
  {
    "start": 143.168,
    "end": 144.432,
    "text": "拳臂够不到，"
  },
  {
    "start": 144.452,
    "end": 144.895,
    "text": "打空。"
  },
  {
    "start": 149.912,
    "end": 150.869,
    "text": "横向对准，"
  },
  {
    "start": 150.889,
    "end": 152.949,
    "text": "拳臂经过身体左边一列，"
  },
  {
    "start": 152.969,
    "end": 153.412,
    "text": "打中！"
  },
  {
    "start": 158.412,
    "end": 160.142,
    "text": "只差一列也没有重叠，"
  },
  {
    "start": 160.162,
    "end": 160.833,
    "text": "所以打空。"
  },
  {
    "start": 161.795,
    "end": 162.435,
    "text": "记住："
  },
  {
    "start": 162.455,
    "end": 163.775,
    "text": "先看有没有对准，"
  },
  {
    "start": 163.795,
    "end": 165.635,
    "text": "再看够不够得到。"
  },
  {
    "start": 165.655,
    "end": 168.498,
    "text": "今天的数字只属于这个固定场景；"
  },
  {
    "start": 168.518,
    "end": 169.862,
    "text": "机器人换了位置，"
  },
  {
    "start": 169.882,
    "end": 173.214,
    "text": "通用办法仍是检查两个区域有没有重叠。"
  },
  {
    "start": 173.234,
    "end": 173.93,
    "text": "接下来，"
  },
  {
    "start": 173.95,
    "end": 175.802,
    "text": "用一首歌把知识点记牢！"
  }
]
