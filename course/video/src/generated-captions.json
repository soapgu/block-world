{
  "lesson": [
    {
      "start": 1.2,
      "end": 4.224,
      "text": "欢迎来到方块世界的拳击擂台！"
    },
    {
      "start": 4.224,
      "end": 5.52,
      "text": "同样出一拳，"
    },
    {
      "start": 5.52,
      "end": 6.6,
      "text": "有时打中，"
    },
    {
      "start": 6.6,
      "end": 7.896,
      "text": "有时却打空。"
    },
    {
      "start": 7.896,
      "end": 10.272,
      "text": "计算机究竟怎么判断呢？"
    },
    {
      "start": 19.2,
      "end": 20.91,
      "text": "先看一小段游戏。"
    },
    {
      "start": 20.91,
      "end": 22.834,
      "text": "机器人移动、出拳，"
    },
    {
      "start": 22.834,
      "end": 25.186,
      "text": "打中时对手少一格生命。"
    },
    {
      "start": 25.186,
      "end": 29.034,
      "text": "今天我们要破解这一拳背后的数学秘密。"
    },
    {
      "start": 36.2,
      "end": 38.912,
      "text": "每个格子都有一个门牌号，"
    },
    {
      "start": 38.912,
      "end": 39.816,
      "text": "叫坐标。"
    },
    {
      "start": 39.816,
      "end": 41.625,
      "text": "左下角是零、零。"
    },
    {
      "start": 41.625,
      "end": 44.563,
      "text": "横坐标表示从左往右第几列，"
    },
    {
      "start": 44.563,
      "end": 47.502,
      "text": "纵坐标表示从下往上第几排。"
    },
    {
      "start": 61.2,
      "end": 63.648,
      "text": "蓝色身体占两列、两排，"
    },
    {
      "start": 63.648,
      "end": 64.76,
      "text": "总共四格。"
    },
    {
      "start": 64.76,
      "end": 66.541,
      "text": "横坐标是五和六，"
    },
    {
      "start": 66.541,
      "end": 68.321,
      "text": "纵坐标是三和四。"
    },
    {
      "start": 68.321,
      "end": 69.433,
      "text": "判断命中，"
    },
    {
      "start": 69.433,
      "end": 72.771,
      "text": "就要知道拳臂会不会碰到这四格。"
    },
    {
      "start": 86.2,
      "end": 88.205,
      "text": "拳头从六、五出发，"
    },
    {
      "start": 88.205,
      "end": 90.432,
      "text": "拳臂再向下伸出三格。"
    },
    {
      "start": 90.432,
      "end": 91.546,
      "text": "连同起点，"
    },
    {
      "start": 91.546,
      "end": 92.883,
      "text": "一共占四格。"
    },
    {
      "start": 92.883,
      "end": 96.447,
      "text": "我们让橙色拳臂一格一格地走下去。"
    },
    {
      "start": 116.2,
      "end": 116.65,
      "text": "看，"
    },
    {
      "start": 116.65,
      "end": 119.347,
      "text": "拳臂经过六、四和六、三。"
    },
    {
      "start": 119.347,
      "end": 122.269,
      "text": "这两个格子也属于蓝色身体。"
    },
    {
      "start": 122.269,
      "end": 124.067,
      "text": "橙色和蓝色重叠，"
    },
    {
      "start": 124.067,
      "end": 125.191,
      "text": "变成绿色，"
    },
    {
      "start": 125.191,
      "end": 126.765,
      "text": "这一拳打中了。"
    },
    {
      "start": 141.2,
      "end": 143.189,
      "text": "把拳头移到八、六。"
    },
    {
      "start": 143.189,
      "end": 144.957,
      "text": "纵向虽然够得到，"
    },
    {
      "start": 144.957,
      "end": 148.052,
      "text": "横坐标八却不在身体的两列里。"
    },
    {
      "start": 148.052,
      "end": 149.82,
      "text": "拳臂从旁边经过，"
    },
    {
      "start": 149.82,
      "end": 150.925,
      "text": "所以打空。"
    },
    {
      "start": 161.2,
      "end": 162.545,
      "text": "再看六、八。"
    },
    {
      "start": 162.545,
      "end": 164.113,
      "text": "横向已经对准，"
    },
    {
      "start": 164.113,
      "end": 166.803,
      "text": "但拳臂最远只到纵坐标五，"
    },
    {
      "start": 166.803,
      "end": 169.492,
      "text": "碰不到身体的最高一排四，"
    },
    {
      "start": 169.492,
      "end": 170.837,
      "text": "所以也打空。"
    },
    {
      "start": 181.2,
      "end": 185.678,
      "text": "在这个身体固定、拳臂向下伸三格的场景里，"
    },
    {
      "start": 185.678,
      "end": 187.916,
      "text": "起点位于身体上方时，"
    },
    {
      "start": 187.916,
      "end": 189.707,
      "text": "横坐标是五或六，"
    },
    {
      "start": 189.707,
      "end": 192.394,
      "text": "纵坐标可以是五、六或七。"
    },
    {
      "start": 192.394,
      "end": 193.737,
      "text": "比如六、七，"
    },
    {
      "start": 193.737,
      "end": 196.2,
      "text": "拳臂末端仍会碰到身体。"
    },
    {
      "start": 196.2,
      "end": 198.438,
      "text": "两个条件要同时成立。"
    },
    {
      "start": 206.2,
      "end": 207.487,
      "text": "现在轮到你。"
    },
    {
      "start": 207.487,
      "end": 209.417,
      "text": "每题先自己想一想，"
    },
    {
      "start": 209.417,
      "end": 211.562,
      "text": "答案会在倒数后出现。"
    },
    {
      "start": 221.5,
      "end": 222.83,
      "text": "横坐标对准，"
    },
    {
      "start": 222.83,
      "end": 224.161,
      "text": "纵坐标够到。"
    },
    {
      "start": 224.161,
      "end": 225.935,
      "text": "拳臂与身体重叠，"
    },
    {
      "start": 225.935,
      "end": 226.6,
      "text": "打中！"
    },
    {
      "start": 234.5,
      "end": 236.553,
      "text": "横坐标八偏到右边，"
    },
    {
      "start": 236.553,
      "end": 237.922,
      "text": "虽然够得到，"
    },
    {
      "start": 237.922,
      "end": 239.063,
      "text": "仍然打空。"
    },
    {
      "start": 247.5,
      "end": 248.895,
      "text": "横向对准了，"
    },
    {
      "start": 248.895,
      "end": 250.289,
      "text": "但纵向太远，"
    },
    {
      "start": 250.289,
      "end": 251.684,
      "text": "拳臂够不到，"
    },
    {
      "start": 251.684,
      "end": 252.381,
      "text": "打空。"
    },
    {
      "start": 260.5,
      "end": 261.614,
      "text": "横向对准，"
    },
    {
      "start": 261.614,
      "end": 264.066,
      "text": "拳臂经过身体左边一列，"
    },
    {
      "start": 264.066,
      "end": 264.735,
      "text": "打中！"
    },
    {
      "start": 273.5,
      "end": 275.578,
      "text": "只差一列也没有重叠，"
    },
    {
      "start": 275.578,
      "end": 276.617,
      "text": "所以打空。"
    },
    {
      "start": 281.2,
      "end": 283.503,
      "text": "记住：先看有没有对准，"
    },
    {
      "start": 283.503,
      "end": 285.177,
      "text": "再看够不够得到。"
    },
    {
      "start": 285.177,
      "end": 288.317,
      "text": "今天的数字只属于这个固定场景；"
    },
    {
      "start": 288.317,
      "end": 289.992,
      "text": "机器人换了位置，"
    },
    {
      "start": 289.992,
      "end": 293.76,
      "text": "通用办法仍是检查两个区域有没有重叠。"
    },
    {
      "start": 293.76,
      "end": 294.597,
      "text": "接下来，"
    },
    {
      "start": 294.597,
      "end": 297.109,
      "text": "用一段说唱把知识点记牢！"
    }
  ],
  "rap": [
    {
      "start": 0.0,
      "end": 2.609,
      "text": "方块擂台，准备开场"
    },
    {
      "start": 2.609,
      "end": 5.217,
      "text": "左右出拳，谁来判定"
    },
    {
      "start": 5.217,
      "end": 7.826,
      "text": "别靠眼睛，猜来猜去"
    },
    {
      "start": 7.826,
      "end": 10.435,
      "text": "坐标登场，给你依据"
    },
    {
      "start": 10.435,
      "end": 13.043,
      "text": "左下原点，零零坐标"
    },
    {
      "start": 13.043,
      "end": 15.652,
      "text": "向右是横，向上是高"
    },
    {
      "start": 15.652,
      "end": 18.261,
      "text": "身体四格，蓝色记号"
    },
    {
      "start": 18.261,
      "end": 20.87,
      "text": "五六两列，三四两排"
    },
    {
      "start": 20.87,
      "end": 23.478,
      "text": "拳头起点，橙色亮起"
    },
    {
      "start": 23.478,
      "end": 26.087,
      "text": "向下三格，一路到底"
    },
    {
      "start": 26.087,
      "end": 28.696,
      "text": "碰上身体，绿色出现"
    },
    {
      "start": 28.696,
      "end": 31.304,
      "text": "重叠一格，命中判定"
    },
    {
      "start": 31.304,
      "end": 33.913,
      "text": "横坐标五，或者是六"
    },
    {
      "start": 33.913,
      "end": 36.522,
      "text": "纵坐标五，六或是七"
    },
    {
      "start": 36.522,
      "end": 39.13,
      "text": "两个都对，拳头命中"
    },
    {
      "start": 39.13,
      "end": 41.739,
      "text": "只对一个，仍然落空"
    },
    {
      "start": 41.739,
      "end": 44.348,
      "text": "六五出拳，重叠明显"
    },
    {
      "start": 44.348,
      "end": 46.957,
      "text": "打中一拳，答案兑现"
    },
    {
      "start": 46.957,
      "end": 49.565,
      "text": "八六太偏，擦肩而过"
    },
    {
      "start": 49.565,
      "end": 52.174,
      "text": "横向没对，拳头落空"
    },
    {
      "start": 52.174,
      "end": 54.783,
      "text": "六八对列，距离太远"
    },
    {
      "start": 54.783,
      "end": 57.391,
      "text": "三格伸完，碰不着边"
    },
    {
      "start": 57.391,
      "end": 60.0,
      "text": "五六出拳，拳臂碰到"
    },
    {
      "start": 60.0,
      "end": 62.609,
      "text": "绿色一亮，打中知道"
    },
    {
      "start": 62.609,
      "end": 65.217,
      "text": "七五靠边，还差一列"
    },
    {
      "start": 65.217,
      "end": 67.826,
      "text": "没有重叠，别说打中"
    },
    {
      "start": 67.826,
      "end": 70.435,
      "text": "先看横向，再看纵向"
    },
    {
      "start": 70.435,
      "end": 73.043,
      "text": "每个格子，挨个点亮"
    },
    {
      "start": 73.043,
      "end": 75.652,
      "text": "换了位置，数字会变"
    },
    {
      "start": 75.652,
      "end": 78.261,
      "text": "重叠检测，原理不变"
    },
    {
      "start": 78.261,
      "end": 80.87,
      "text": "坐标拳击，一起来练"
    },
    {
      "start": 80.87,
      "end": 83.478,
      "text": "自己判断，再打下一拳"
    }
  ]
}
